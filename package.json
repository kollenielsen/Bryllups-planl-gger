    "migrate": "tsx src/scripts/migrate.ts",
    "seed": "tsx src/scripts/seed-demo.ts",
    "eval:parse": "tsx src/scripts/eval-parse.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
