{
  "name": "bryllups-planlaegger",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI-agent der kontakter bryllupsleverandoerer paa parrets vegne",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
