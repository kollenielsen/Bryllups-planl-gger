# ---------------------------------------------------------------------------
# Kopiér til .env og udfyld. Alt har en fornuftig default, så appen kører
# uden konfiguration — men så sender den intet og kalder ikke modellen.
# ---------------------------------------------------------------------------

PORT=3000
BASE_URL=http://localhost:3000

# --- Database --------------------------------------------------------------
# Tom: PGlite (Postgres i WASM) på disk i ./data/pgdata. Intet at installere.
# Udfyldt: rigtig Postgres, fx Supabase. Samme SQL i begge tilfælde.
# DATABASE_URL=postgresql://postgres:kode@db.projekt.supabase.co:5432/postgres
PGLITE_DIR=./data/pgdata

# --- Claude ----------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_PARSE_EFFORT=medium
ANTHROPIC_DRAFT_EFFORT=medium

# --- Mail ------------------------------------------------------------------
# console: skriver .eml-filer til ./outbox i stedet for at sende.
# smtp:    sender rigtigt via nedenstående SMTP-server.
EMAIL_PROVIDER=console
EMAIL_FROM_NAME=Bryllupsplanlægger
EMAIL_FROM=bryllup@ditdomaene.dk

# Svar matches på plus-adressering: reply+<token>@EMAIL_REPLY_DOMAIN.
# Domænet skal have SPF, DKIM og DMARC sat op, ellers ryger mails i spam.
EMAIL_REPLY_DOMAIN=ditdomaene.dk
EMAIL_REPLY_LOCALPART=reply

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Deles med mailudbyderens indgående webhook. Sendes som X-Webhook-Secret
# eller ?token=. Uden den er webhooken åben — kun til lokal udvikling.
INBOUND_WEBHOOK_SECRET=

OUTBOX_DIR=./outbox

# --- Afsendelse ------------------------------------------------------------
# true: intet forlader maskinen. Sæt bevidst til false, når I er klar.
DRY_RUN=true
# Førstehenvendelser skal godkendes i dashboardet før de sendes.
REQUIRE_SEND_APPROVAL=true
SEND_MAX_PER_HOUR=6
SEND_MIN_GAP_SECONDS=240
SEND_JITTER_SECONDS=180
SEND_WINDOW_START_HOUR=8
SEND_WINDOW_END_HOUR=18
MAX_VENDORS_PER_CATEGORY=8
OUTBOX_WORKER_INTERVAL_MS=20000

# --- Agent -----------------------------------------------------------------
# Antal runder pr. tråd før agenten stopper og overlader den til parret.
MAX_TURNS_PER_THREAD=6
# Under denne tærskel flages udtrækket til manuel læsning.
CONFIDENCE_THRESHOLD=0.7

# --- Leverandørsøgning -----------------------------------------------------
# seed: kurateret demoliste (virker uden nøgler).
# places: Google Places API (New) + skrabning af mail fra hjemmesiden.
DISCOVERY_PROVIDER=seed
GOOGLE_PLACES_API_KEY=
DISCOVERY_SCRAPE_EMAILS=true
DISCOVERY_MAX_RESULTS=20
